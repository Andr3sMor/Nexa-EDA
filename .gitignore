# ==============================================================================
# Git Ignore - Nexa Voice of Customer (Cobranza)
# ==============================================================================

# Entornos Virtuales y Variables de Entorno
.env
.env.*
.venv/
venv/
env/
ENV/

# Python / Compilados / Caché
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Jupyter Notebooks
.ipynb_checkpoints/
*/.ipynb_checkpoints/
# Scripts runners auxiliares de ejecución en background para notebooks
notebooks/*.py

# Datos de salida, cachés de extracción y logs locales
outputs/
data/interim/
data/processed/
*.log

# Frontend Web (Vite + React)
web/node_modules/
web/dist/
web/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Documentación interna de prompts y bitácoras de trabajo
CLAUDE.md
docs/
skills-lock.json

# IDEs y Configuración de Sistema Operativo
.vscode/
.idea/
.agents/
.DS_Store
Thumbs.db
desktop.ini
